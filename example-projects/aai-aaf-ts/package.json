{
  "name": "aaf-oidc-local-demo-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Bun and Express backend for an AAF OIDC local demo.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test ./test",
    "test:watch": "bun test --watch ./test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "openid-client": "^6.8.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1"
  }
}
