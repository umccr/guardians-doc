// GUARDIANS solution architecture — LikeC4 model
//
// Docs: https://likec4.dev/dsl/

model {

  // ── External systems ──────────────────────────────────────────────────────

  aaf = externalSystem 'AAF' {
    description 'Australian Access Federation authenticates users with their home institution.'
    style {
      color indigo-muted
    }
  }

  rems = externalSystem 'REMS' {
    description 'Manages data access applications and entitlements.'
    style {
      color rose-muted
      shape browser
    }
  }

  seqera = externalSystem 'Seqera' {
    description 'Analysis environment for Data Consumers.'
    style {
      color green-muted
      shape browser
    }
  }

  globus = externalSystem 'Globus' {
    #notInProduction
    description 'External data transfer system (not in production).'
    style {
      color slate-muted
      shape queue
      border dashed
      icon bootstrap:cone-striped
    }
  }

  infoAssetOwner = person 'Information Asset Owner' {
    description 'Gives standing permission for data to be cached into a node; approves access applications per project.'
    style {
      color amber-muted
    }
  }

  infoAssetOwnerStore = storage 'Long Term Data Storage' {
    description "Object storage holding the Information Asset Owner's source data."
    style {
      color amber-muted
    }
  }

  // ── Node organisation ─────────────────────────────────────────────────────

  operator = person 'Operator' {
    description 'Coordinates activity in the node for datasets / projects.'
    style {
      color primary-muted
    }
  }

  gdn = system 'Genomic Data Node' {
    // description 'Bridges Data Consumer environments and the data held by Information Asset Owners.'

    copy = container 'Data Copy' {
      description 'Copies datasets from Information Asset Owner storage into the node.'
      technology 'AWS Step Functions'
      style {
        shape component
      }
    }

    cache = container 'Data Cache' {
      description 'Holds cached datasets.'
      technology 'Amazon S3'
      style {
        shape bucket
      }
    }

    htsget = container 'htsget' {
      description 'Streams authorised slices of genomic data.'
      technology 'Rust'
      style {
              shape component
      }
    }

    dataReleaser = container 'Data Releaser' {
      description 'Coordinates actual data release.'
      technology 'Go'
      style {
              shape component
           }
    }

    curtrail = container 'Bill and Log Processor' {
      description 'Provides billing and log data for operator analysis.'
      technology 'Python'
      style {
              shape component
            }
    }

    copy -[data]-> cache 'caches datasets to'
    cache -[data]-> htsget 'object data'
    cache -[data]-> seqera 'object data'

    dataReleaser -[control]-> htsget 'configures'
    dataReleaser -[control]-> copy 'triggers'
    dataReleaser -[control]-> cache 'configures'
  }

  // ── Data Consumer organisation ───────────────────────────────────────────

  dataConsumer = person 'Data Consumer' {
    description 'Does science using data.'
    style {
      color green-muted
    }
  }

  // ── Relationships ─────────────────────────────────────────────────────────

  infoAssetOwnerStore -[data]-> gdn.copy 'source datasets'
  infoAssetOwnerStore -[plannedData]-> globus 'source datasets'

  rems -[control]-> aaf 'provides login support'
  seqera -[control]-> aaf 'provides login support'

  globus -[plannedData]-> gdn.cache 'caches datasets to'

  infoAssetOwner -[control]-> rems 'approves access applications in'
  dataConsumer -[control]-> rems 'applies for data access in'
  dataConsumer -[control]-> seqera 'analyses data in'

  operator -[control]-> rems 'gets permissions to share from'
  operator -[control]-> gdn.dataReleaser 'controls data activity in'
  operator -[control]-> gdn.curtrail 'queries'

  gdn.htsget -[data]-> seqera 'genomic data' {
     //technology 'S3 API / htsget API'
  }
}
