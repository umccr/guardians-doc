// GUARDIANS solution architecture — LikeC4 model
//
// Docs: https://likec4.dev/dsl/
//
// Runtime scenario: ported from Structurizr dynamic view "gdn-data-access".

views {

  dynamic view data-access {
    title 'Data Access'
    description 'An approved Data Consumer reads genomic data from their environment.'

    dataConsumer -[control]-> seqera 'Runs an analysis'
    seqera -[control]-> gdn.htsget 'Requests a genomic region'
    gdn.cache -[data]-> gdn.htsget 'Indexes, used to work out byte ranges'
    gdn.htsget -[control]-> seqera 'Returns tickets'
    gdn.cache -[data]-> seqera 'Byte ranges named in the tickets'

    autoLayout LeftRight
  }

}
