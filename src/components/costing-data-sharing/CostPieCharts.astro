---
import costCsv from '../../../scripts/costing-data-sharing/cost_tables.csv?raw';

// Component rows (not totals) of each cost table; slice value = midpoint of min-max.
const splitLine = (line: string) =>
	[...line.matchAll(/("([^"]|"")*"|[^,]*)(,|$)/g)]
		.slice(0, -1)
		.map((m) => m[1].replace(/^"|"$/g, '').replace(/""/g, '"'));

const rows = costCsv
	.trim()
	.split('\n')
	.slice(1)
	.map(splitLine)
	.map(([table, , row, , column, min, max, total]) => ({ table, row, column, min, max, total }))
	.filter((r) => r.total !== '1');

const TABLES = [
	{ table: 'standing', name: 'Standing Costs', color: '#bfdbfe' },
	{ table: 'storage', name: 'Storage Costs', color: '#3b82f6' },
	{ table: 'data-movement', name: 'Data Movement', color: '#1e3a8a' },
];

const categories = TABLES.map(({ table, name, color }) => ({
	name,
	color,
	items: [...new Set(rows.filter((r) => r.table === table).map((r) => r.row))],
}));

const scenarios = Object.fromEntries(
	(['ISP', 'CSP'] as const).map((platform) => [
		platform,
		TABLES.map(({ table }) =>
			rows
				.filter((r) => r.table === table && r.column.includes(`(${platform})`))
				.map((r) => (Number(r.min) + Number(r.max)) / 2)
		),
	])
);
---

  <div
    class="cost-pie-wrapper not-prose not-content"
    data-cost-pie-root
    data-categories={JSON.stringify(categories)}
    data-scenarios={JSON.stringify(scenarios)}
  >
    <div class="cost-pie-charts">
      <div class="cost-pie-card">
        <div class="cost-pie-header">
          <h3>
            <span class="cost-pie-title-main"> Internal Sharing Platform</span>
          </h3>
        </div>
        <div class="cost-pie-canvas-wrap">
          <canvas id="pie-isp"></canvas>
        </div>
        <p class="cost-pie-hover" id="hover-isp"></p>
      </div>
      <div class="cost-pie-card">
        <div class="cost-pie-header">
          <h3>
            <span class="cost-pie-title-main">Cross-Organisation Sharing Platform</span>
          </h3>
        </div>
        <div class="cost-pie-canvas-wrap">
          <canvas id="pie-csp"></canvas>
        </div>
        <p class="cost-pie-hover" id="hover-csp"></p>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

  <script>
    (function () {
      const rootEl = document.querySelector('[data-cost-pie-root]');
      // Category names, colours and per-scenario values are built from cost_tables.csv
      const CATEGORIES = JSON.parse(rootEl.dataset.categories);
      const SCENARIOS = JSON.parse(rootEl.dataset.scenarios);

      function buildPaletteAndLabels() {
        const colors = [];
        const labels = [];
        const groupByIndex = [];
        CATEGORIES.forEach((cat, catIdx) => {
          cat.items.forEach((item) => {
            colors.push(cat.color);
            labels.push(`${cat.name} – ${item}`);
            groupByIndex.push(catIdx);
          });
        });
        return { colors, labels, groupByIndex };
      }

      function flatValues(scenarioValues) {
        return scenarioValues.flat();
      }

      function createChart(canvasId, hoverId, values, labels, colors, groupByIndex, realTotal) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        const total = realTotal;
        const hoverEl = document.getElementById(hoverId);
        const defaultHoverText = `Total: ~$${total.toLocaleString()}/month`;
        const defaultHoverHtml = `<strong class="cost-pie-default-total">${defaultHoverText}</strong>`;
        if (hoverEl) hoverEl.innerHTML = defaultHoverHtml;

        const defaultBorderWidth = new Array(values.length).fill(2);
        const fadedColor = 'rgba(148, 163, 184, 0.28)';

        // @ts-ignore
        const chart = new Chart(canvas, {
          type: 'doughnut',
          data: {
            labels,
            datasets: [
              {
                data: values,
                backgroundColor: colors,
                borderColor: '#ffffff',
                borderWidth: defaultBorderWidth,
                hoverOffset: 0,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            cutout: '42%',
            onHover(_event, activeElements) {
              const dataset = chart.data.datasets[0];
              const nextColors = [...colors];
              const nextBorderWidths = new Array(values.length).fill(2);

              if (activeElements.length > 0) {
                const hoveredIndex = activeElements[0].index;
                const hoveredGroup = groupByIndex[hoveredIndex];
                const hoveredLabel = labels[hoveredIndex];
                const hoveredValue = values[hoveredIndex];
                const hoveredPct = ((hoveredValue / total) * 100).toFixed(1);
                const [mainComponent, subComponent] = hoveredLabel.split(' – ');

                for (let i = 0; i < values.length; i++) {
                  if (groupByIndex[i] !== hoveredGroup) {
                    nextColors[i] = fadedColor;
                  }
                }

                nextBorderWidths[hoveredIndex] = 4;
                if (hoverEl) {
                  hoverEl.innerHTML = `<strong>${mainComponent}</strong>${subComponent ? ` — ${subComponent}` : ''}: ~$${hoveredValue.toLocaleString()}/month (${hoveredPct}%)`;
                }
              } else if (hoverEl) {
                hoverEl.innerHTML = defaultHoverHtml;
              }

              dataset.backgroundColor = nextColors;
              dataset.borderWidth = nextBorderWidths;
              chart.update('none');
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                enabled: false,
              },
            },
          },
        });
      }

      function init() {
        const { colors, labels, groupByIndex } = buildPaletteAndLabels();
        const ispReal = SCENARIOS.ISP.flat().reduce((a, b) => a + b, 0);
        const cspReal = SCENARIOS.CSP.flat().reduce((a, b) => a + b, 0);
        createChart('pie-isp', 'hover-isp', flatValues(SCENARIOS.ISP), labels, colors, groupByIndex, ispReal);
        createChart('pie-csp', 'hover-csp', flatValues(SCENARIOS.CSP), labels, colors, groupByIndex, cspReal);
      }

      const root = document.querySelector('[data-cost-pie-root]');
      let initialized = false;

      function renderOnce() {
        if (initialized) return;
        initialized = true;
        init();
      }

      function whenChartReady(callback) {
        if (typeof Chart !== 'undefined') {
          callback();
          return;
        }
        const scripts = document.querySelectorAll('script[src*="chart.js"]');
        const lastScript = scripts[scripts.length - 1];
        if (lastScript) {
          lastScript.addEventListener('load', callback, { once: true });
        } else {
          window.addEventListener('load', callback, { once: true });
        }
      }

      function revealAndRender() {
        if (root) {
          root.classList.add('is-visible');
        }
        whenChartReady(renderOnce);
      }

      if (!root) {
        revealAndRender();
        return;
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                revealAndRender();
                observer.disconnect();
              }
            });
          },
          { threshold: 0.3 }
        );
        observer.observe(root);
      } else {
        revealAndRender();
      }
    })();
  </script>

  <style>
    .cost-pie-wrapper {
      margin: 2rem 0;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 420ms ease, transform 420ms ease;
    }

    .cost-pie-wrapper.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .cost-pie-charts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      
    }

    @media (max-width: 720px) {
      .cost-pie-charts {
        grid-template-columns: 1fr;
      }
    }

    .cost-pie-card {
      display: grid;
      grid-template-rows: 4.25rem 320px 3rem;
      justify-items: center;
      gap: 0.25rem;
      width: 320px;
      margin-inline: auto;
    }

    .cost-pie-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 0.25rem;
      width: 320px;
      min-height: 4.25rem;
    }

    .cost-pie-card h3 {
      font-size: 0.9rem;
      font-weight: 600;
      text-align: center;
      margin: 0;
      line-height: 1.25;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.05rem;
      min-height: 3rem;
      justify-content: center;
    }

    .cost-pie-title-main {
      text-align: center;
    }

    .cost-pie-canvas-wrap {
      width: 320px;
      height: 320px;
    }

    .cost-pie-canvas-wrap canvas {
      width: 100% !important;
      height: 100% !important;
    }

    .cost-pie-hover {
      margin: 0.8rem 0 0;
      width: 320px;
      min-height: 100%;
      padding: 0.5rem 0.75rem;
      font-size: 0.78rem;
      line-height: 1.3;
      text-align: center;
      opacity: 0.8;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.75rem;
      background: var(--sl-color-bg);
      box-sizing: border-box;
    }

    .cost-pie-hover :global(.cost-pie-default-total) {
      font-size: 1rem;
      font-weight: 700;
    }

    @media (max-width: 720px) {
      .cost-pie-card {
        grid-template-rows: 4.25rem 300px 3rem;
        width: 300px;
      }

      .cost-pie-header {
        width: 300px;
      }

      .cost-pie-canvas-wrap {
        width: 300px;
        height: 300px;
      }

      .cost-pie-hover {
        width: 300px;
      }
    }


  </style>
