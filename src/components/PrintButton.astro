---
// A button that opens the browser's print dialog, where readers can print
// the page or save it as a PDF.
interface Props {
	label?: string;
}
const { label = 'Print or save as PDF' } = Astro.props;
---

<p class="print-button not-content" data-print-button hidden>
	<button type="button">{label}</button>
</p>

<script>
	for (const el of document.querySelectorAll<HTMLElement>('[data-print-button]')) {
		el.hidden = false;
		el.querySelector('button')?.addEventListener('click', () => window.print());
	}
</script>

<style>
	.print-button[hidden] {
		display: none;
	}
	.print-button button {
		padding: 0.25rem 0.8rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.print-button button:hover {
		border-color: var(--sl-color-text-accent);
	}
	.print-button button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	@media print {
		.print-button {
			display: none !important;
		}
	}
</style>
