---
type ScrollyStep = {
	id?: string;
	title: string;
	text: string;
	image: string;
	link: string;
	linkText: string;
};

interface Props {
	steps: ScrollyStep[];
}

const { steps = [] } = Astro.props;

const normalizeWithBase = (value: string) => {
	if (!value) return value;
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('data:')) {
		return value;
	}
	if (value.startsWith('/')) {
		return `${import.meta.env.BASE_URL}${value.slice(1)}`;
	}
	return value;
};
---

<div class="not-prose scrolly-root grid grid-cols-1 gap-10 md:grid-cols-2" data-scrolly-root>
	<div class="md:sticky md:top-20 h-[55vh] md:h-[70vh]">
		<div class="relative h-full w-full overflow-hidden rounded border p-4">
			{steps.map((step, index) => (
				<img
					data-scrolly-visual
					data-index={String(index)}
					src={normalizeWithBase(step.image)}
					alt={step.title}
					loading="lazy"
					class:list={[
						'scrolly-visual absolute inset-0 h-full w-full object-contain transition-opacity duration-500',
						index === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none',
					]}
				/>
			))}
		</div>
	</div>

	<div class="space-y-20 md:space-y-28">
		{steps.map((step, index) => (
			<section
				id={step.id}
				data-scrolly-step
				data-index={String(index)}
				class="scrolly-step min-h-[70vh] flex items-center"
			>
				<div
					data-scrolly-copy
					class:list={[
						'max-w-prose space-y-4 transition-all duration-300',
						index === 0 ? 'opacity-100 translate-y-0' : 'opacity-50 translate-y-4',
					]}
				>
					<h3 class="text-2xl font-semibold">{step.title}</h3>
					<p>{step.text}</p>
					<a href={step.link} class="inline-block rounded border px-4 py-2">
						{step.linkText}
					</a>
				</div>
			</section>
		))}
	</div>
</div>

<script>
	const roots = document.querySelectorAll('[data-scrolly-root]');

	for (const root of roots) {
		const stepElements = Array.from(root.querySelectorAll('[data-scrolly-step]'));
		const visualElements = Array.from(root.querySelectorAll('[data-scrolly-visual]'));
		const copyElements = Array.from(root.querySelectorAll('[data-scrolly-copy]'));

		if (stepElements.length === 0) continue;

		const activate = (activeIndex) => {
			visualElements.forEach((visual, index) => {
				visual.classList.toggle('opacity-100', index === activeIndex);
				visual.classList.toggle('opacity-0', index !== activeIndex);
				visual.classList.toggle('pointer-events-none', index !== activeIndex);
			});

			copyElements.forEach((copy, index) => {
				copy.classList.toggle('opacity-100', index === activeIndex);
				copy.classList.toggle('translate-y-0', index === activeIndex);
				copy.classList.toggle('opacity-50', index !== activeIndex);
				copy.classList.toggle('translate-y-4', index !== activeIndex);
			});
		};

		activate(0);

		const observer = new IntersectionObserver(
			(entries) => {
				const visibleEntries = entries.filter((entry) => entry.isIntersecting);
				if (visibleEntries.length === 0) return;

				visibleEntries.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
				const topEntry = visibleEntries[0];
				const activeIndex = Number(topEntry.target.getAttribute('data-index') || 0);
				activate(activeIndex);
			},
			{
				root: null,
				threshold: [0.2, 0.4, 0.6, 0.8],
				rootMargin: '-20% 0px -35% 0px',
			}
		);

		stepElements.forEach((step) => observer.observe(step));
	}
</script>
