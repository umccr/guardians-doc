---
import CostCumulativeBars from './CostCumulativeBars.astro';

interface Props {
  steps: {
    id: string;
    title: string;
    text: string;
    visual: string;
    link?: string;
    linkText?: string;
    chart?: {
      title?: string;
      max?: number;
      bars: { label: string; values: number[] }[];
    };
  }[];
}
const { steps } = Astro.props;

const initialStep = steps[0];
---

<div class="report-scrolly-layout">
  <!-- Left Side: Scrolling Markdown Steps -->
  <div class="scrolly-text-pane">
    {steps.map((step) => (
      <div
        class="scrolly-step-card"
        data-step-id={step.id}
      >
        <h3>{step.title}</h3>
        <p>{step.text}</p>
        {step.link ? (
          <p style="margin-top:0.75rem;"><a class="read-more" href={step.link}>{step.linkText ?? 'Read more'}</a></p>
        ) : null}
      </div>
    ))}
  </div>

  <!-- Right Side: Sticky Visual Container -->
  <div class="scrolly-visual-pane">
    <div class="visual-box" id="scrolly-display">
      {steps.map((step, i) => (
        <div class="chart-slide" data-step-chart={step.id} aria-hidden={i !== 0 ? 'true' : 'false'}>
          {step.chart && <CostCumulativeBars title={step.chart.title} max={step.chart.max} bars={step.chart.bars} />}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .report-scrolly-layout {
    display: flex;
    position: relative;
    gap: 2rem;
    margin: 3rem 0;
  }
  .scrolly-visual-pane {
    flex: 1;
    position: sticky;
    top: 5rem; /* Adjust based on your doc page header height */
    height: 60vh;
    display: flex;
    align-items: stretch;
  }
  .visual-box {
    width: 100%;
    height: 100%;
    background: var(--sl-color-bg-subtle, #f4f4f5);
    border: 1px solid var(--sl-color-hairline, #e4e4e7);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    overflow: hidden;
    position: relative;
  }

  .chart-slide {
    position: absolute;
    inset: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  .chart-slide[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }
  .scrolly-text-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 50vh; /* Pushes narrative text apart so it scrolls cleanly */
    padding-bottom: 30vh;
  }
  .scrolly-step-card {
    background: var(--sl-color-bg, #ffffff);
    border: 1px solid var(--sl-color-hairline, #e4e4e7);
    padding: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: var(--sl-shadow-sm);
    position: relative;
  }

  .read-more {
    display: inline-block;
    padding: 0.4rem 0.6rem;
    background: transparent;
    border: 1px solid var(--sl-color-hairline, #e4e4e7);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
  }
</style>

<script>
  function activateStep(stepId) {
    document.querySelectorAll('.chart-slide').forEach((slide) => {
      const isActive = slide.getAttribute('data-step-chart') === stepId;
      slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const stepId = entry.target.getAttribute('data-step-id');
        activateStep(stepId);
        entry.target.style.opacity = '1';
      } else {
        entry.target.style.opacity = '0.4';
      }
    });
  }, {
    rootMargin: '0px 0px -40% 0px',
    threshold: 0.2
  });

  const stepCards = document.querySelectorAll('.scrolly-step-card');
  stepCards.forEach(card => observer.observe(card));

  if (stepCards.length > 0) {
    const firstId = stepCards[0].getAttribute('data-step-id');
    activateStep(firstId);
    stepCards[0].style.opacity = '1';
  }
</script>
