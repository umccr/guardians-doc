    }

    @media (max-width: 720px) {
      .cost-pie-card {
        grid-template-rows: 4.25rem 300px 3rem;
        width: 300px;
      }

      .cost-pie-header {
        width: 300px;
      }

      .cost-pie-canvas-wrap {
        width: 300px;
