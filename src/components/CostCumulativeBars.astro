---
interface Props {
  title?: string;
  max?: number;
  bars: { label: string; values: number[] }[];
}

const { title, max, bars = [] } = Astro.props;

const localMax = Math.max(...bars.map(b => b.values.reduce((a, v) => a + v, 0)), 1);
const scaleMax = max ?? localMax;

const segmentColors = [
  'var(--sl-color-accent-low, #bfdbfe)',
  'var(--sl-color-accent, #2563eb)',
  'var(--sl-color-accent-high, #1d4ed8)',
  '#7c3aed',
];

const fmtK = (v: number) => v >= 1000 ? `$${Math.round(v / 100) / 10}K` : `$${Math.round(v)}`;
---

<div class="cbars">
  {title && <div class="cbars-title">{title}</div>}
  <div class="cbars-stage">
    <div class="cbars-ylabel">USD / month</div>
    <div class="cbars-row">
    {bars.map(bar => {
      const total = bar.values.reduce((a, b) => a + b, 0);
      return (
        <div class="cbar-col">
          <div class="cbar-total">{fmtK(total)}</div>
          <div class="cbar-stack">
            <div class="cbar-spacer" style={`flex: ${scaleMax - total} 0 0;`} />
            {[...bar.values].reverse().map((v, i) => (
              <div
                class="cbar-seg"
                style={`flex: ${v} 0 0; background: ${segmentColors[(bar.values.length - 1 - i) % segmentColors.length]};`}
                title={fmtK(v)}
              />
            ))}
          </div>
          <div class="cbar-label">{bar.label}</div>
        </div>
      );
    })}
    </div>
  </div>
</div>

<style>
  .cbars-stage {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    min-height: 0;
  }

  .cbars-ylabel {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.68rem;
    color: var(--sl-color-muted, #6b7280);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  .cbars {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-height: 0;
  }

  .cbars-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--sl-color-muted, #6b7280);
  }

  .cbars-row {
    display: flex;
    gap: 1.5rem;
    align-items: flex-end;
    flex: 1;
    min-height: 0;
    height: 100%;
  }

  .cbar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    flex: 1;
    min-height: 0;
    height: 100%;
  }

  .cbar-total {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sl-color-muted, #6b7280);
  }

  .cbar-stack {
    flex: 1;
    width: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 8px;
    background: var(--sl-color-bg, white);
    padding: 0;
  }

  .cbar-spacer {
    background: transparent;
  }

  .cbar-seg {
    width: 100%;
    min-height: 2px;
    border-radius: 6px;
  }

  .cbar-label {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--sl-color-muted, #6b7280);
    text-align: center;
  }
</style>
