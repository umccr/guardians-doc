---
// One entry on the SATRE for Genomics page: its heading, its type and status,
// and the SATRE requirement that it is about, quoted from the SATRE
// specification file. The discussion of the entry follows the tag on the page.
//
//   <Entry id="2.1.G1" capability="2.1" title="Dynamic compute"
//     topic="Scalable compute" type="new" status="open"
//     statusText="Open (Meeting #7)." />
//
// genomics-entries.ts reads the same tags from the source of the page for the
// lists and the map. Both use toEntry() to check the attributes and fill in
// the fields that a tag leaves out, so the entry here and in the lists cannot
// disagree.
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { toEntry } from '../../data/satre/genomics-entries';
import TypeBadge from './TypeBadge.astro';

const entry = toEntry(Astro.props);
const r = entry.requirement;

// The heading starts with the ID of the entry, unless the entry has a label
// of its own, as a general note does.
const numbered = entry.label === entry.id;
---

<AnchorHeading level={entry.level} id={entry.anchor}>
	{numbered && `${entry.id} `}
	{entry.heading}
</AnchorHeading>
<p>
	<TypeBadge type={entry.type} />{' '}
	<em>{entry.statusText}</em>
</p>
{
	r && (
		<blockquote>
			<p>
				<strong>SATRE ({r.importance}):</strong> {r.statement}
			</p>
		</blockquote>
	)
}
