---
// A table that counts the genomics differences by topic and by status. Each
// number links to the summary list on the SATRE for Genomics page, with the
// matching filter set.
import { summaryHref, statusLabel } from '../../data/satre/genomics-entries';
import type { EntryStatus, Topic } from '../../data/satre/genomics-entries';
import { topicGroups, totals, STATUS_ORDER } from '../../data/satre/genomics-views';
import Mark from './Mark.astro';

const rows: { label: string; topic?: Topic; counts: Record<EntryStatus, number>; all: number }[] = [
	...topicGroups.map((t) => ({ label: t.label, topic: t.id, counts: t.byStatus, all: t.differences.length })),
	{ label: 'All topics', counts: totals.byStatus, all: totals.differences },
];
---

<table class="tabular-nums max-sm:text-sm max-sm:[&_:is(th,td)]:px-1.5">
	<thead>
		<tr>
			<th scope="col">Topic</th>
			{
				STATUS_ORDER.map((s) => (
					<th scope="col" class="text-right whitespace-nowrap">
						<Mark status={s} class="max-sm:hidden" /> {statusLabel(s)}
					</th>
				))
			}
			<th scope="col" class="text-right">All</th>
		</tr>
	</thead>
	<tbody>
		{
			rows.map((row) => (
				<tr class:list={{ 'font-semibold': !row.topic }}>
					<th scope="row" class:list={{ 'font-normal': !!row.topic }}>
						{row.label}
					</th>
					{STATUS_ORDER.map((s) => (
						<td class="text-right">
							{row.counts[s] > 0 ? (
								<a href={summaryHref({ topic: row.topic, status: s })}>{row.counts[s]}</a>
							) : (
								<span class="text-gray-400">0</span>
							)}
						</td>
					))}
					<td class="text-right">
						<a href={summaryHref({ topic: row.topic })}>{row.all}</a>
					</td>
				</tr>
			))
		}
	</tbody>
</table>
