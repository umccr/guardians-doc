---
// The summary on the SATRE for Genomics page: a list with one row for each
// genomics entry, which the reader can search and filter. A row links to the
// full entry further down the same page.
//
// The filters are a <form>, and the script keeps the form's values in the
// page address, for example `?topic=Scalable+compute&status=open`.
import { EntryStatus, EntryType, statusLabels, topicsOf, typeLabels } from '../../data/satre/genomics-entries';
import { differences as entries } from '../../data/satre/genomics-views';
import EntryList from './EntryList.astro';

const menus = [
	{ name: 'topic', all: 'All topics', options: topicsOf(entries).map((t) => ({ value: t, label: t })) },
	{
		name: 'type',
		all: 'All types',
		options: EntryType.options
			.filter((t) => entries.some((e) => e.type === t))
			.map((t) => ({ value: t, label: typeLabels[t] })),
	},
	{ name: 'status', all: 'All statuses', options: EntryStatus.options.map((s) => ({ value: s, label: statusLabels[s] })) },
];
const control = 'rounded-md border border-gray-400 bg-white px-2 py-1.5';
---

<div data-satre-summary>
	<form
		class="not-content z-10 flex flex-wrap items-center gap-2 bg-white py-2 text-sm sm:sticky sm:top-(--sl-nav-height) print:hidden noscript:hidden"
	>
		<input
			type="search"
			name="q"
			placeholder="Find an ID or a title"
			aria-label="Find an ID or a title"
			class:list={[control, 'min-w-36 flex-1']}
		/>
		{
			menus.map((menu) => (
				<select name={menu.name} aria-label={`Filter by ${menu.name}`} class={control}>
					<option value="">{menu.all}</option>
					{menu.options.map((o) => (
						<option value={o.value}>{o.label}</option>
					))}
				</select>
			))
		}
		<output class="ml-auto text-gray-500 tabular-nums" />
		<button type="reset" class="cursor-pointer border-0 bg-transparent p-0 text-accent-600 underline">Clear</button>
	</form>
	<EntryList entries={entries} />
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-satre-summary]')) {
		const form = root.querySelector('form')!;
		const count = root.querySelector('output')!;
		const rows = [...root.querySelectorAll<HTMLElement>('li')];

		const apply = () => {
			const filters = [...new FormData(form)].filter(([, value]) => value) as [string, string][];
			for (const row of rows) {
				row.hidden = !filters.every(([name, value]) =>
					name === 'q' ? row.dataset.q!.includes(value.trim().toLowerCase()) : row.dataset[name] === value,
				);
			}
			const shown = rows.filter((row) => !row.hidden).length;
			count.textContent = shown === rows.length ? `${shown} entries` : `${shown} of ${rows.length} entries`;
			// replaceState keeps the Back button for leaving the page. It would
			// otherwise step back through every filter change.
			const query = new URLSearchParams(filters).toString();
			history.replaceState(history.state, '', `${location.pathname}${query && `?${query}`}${location.hash}`);
		};

		// Start from the filters in the page address, if it has any.
		for (const [name, value] of new URLSearchParams(location.search)) {
			const field = form.elements.namedItem(name);
			if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value;
			if (field instanceof HTMLSelectElement && field.selectedIndex < 0) field.value = '';
		}

		form.addEventListener('input', apply);
		form.addEventListener('reset', () => setTimeout(apply));
		apply();
	}
</script>
