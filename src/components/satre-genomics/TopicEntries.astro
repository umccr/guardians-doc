---
// The genomics entries for one topic, as a list that opens in place. The
// report puts one at the end of each topic section, so a reader can see the
// entries behind that section without leaving it.
//
// Each row links to the full entry on the SATRE for Genomics page. The list
// repeats none of that page's text.
//
// The list is a <details> element, so it opens without JavaScript. The
// script only opens every list before the page is printed.
import { fullEntryHref } from '../../data/satre/genomics-entries';
import type { Topic } from '../../data/satre/genomics-entries';
import { topicGroups, plural, statusPhrase, STATUS_ORDER } from '../../data/satre/genomics-views';
import EntryList from './EntryList.astro';
import './satre-shared.css';

interface Props {
	topic: Topic;
}
const { topic } = Astro.props;
const group = topicGroups.find((t) => t.id === topic);
if (!group) throw new Error(`TopicEntries: unknown topic "${topic}"`);
---

<details class="satre-tokens satre-topic not-content" data-lens="status" data-satre-topic>
	<summary>
		<span class="satre-topic__title">
			{plural(group.differences.length, 'entry', 'entries')} on {group.label.toLowerCase()}
		</span>
		<span class="satre-topic__track" aria-hidden="true">
			{
				STATUS_ORDER.filter((s) => group.byStatus[s] > 0).map((s) => (
					<i class="satre-seg" data-status={s} style={`--n:${group.byStatus[s]}`} />
				))
			}
		</span>
		<span class="satre-topic__counts">{statusPhrase(group.byStatus)}</span>
	</summary>
	<EntryList entries={group.differences} mode="link" />
	{
		group.reviewed.length > 0 && (
			<p class="satre-topic__reviewed">
				The group also reviewed and rejected a draft change to{' '}
				{group.reviewed.map((e, i) => (
					<>
						{i > 0 && (i === group.reviewed.length - 1 ? ' and ' : ', ')}
						<a href={fullEntryHref(e)}>
							{e.label} {e.title}
						</a>
					</>
				))}
				.
			</p>
		)
	}
</details>

<script>
	// A closed list would print as its one summary line. So open every list
	// before the page prints, and put each back as it was afterwards.
	const lists = [...document.querySelectorAll<HTMLDetailsElement>('[data-satre-topic]')];
	let openBeforePrint: boolean[] | null = null;
	window.addEventListener('beforeprint', () => {
		openBeforePrint = lists.map((list) => list.open);
		for (const list of lists) list.open = true;
	});
	window.addEventListener('afterprint', () => {
		openBeforePrint?.forEach((open, i) => (lists[i].open = open));
		openBeforePrint = null;
	});
</script>

<style is:global>
	/* The marks, the status bar and the rows come from satre-shared.css. */
	.satre-topic {
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		font-size: var(--sl-text-sm);
		line-height: 1.45;
		color: var(--sl-color-white);
	}
	.satre-topic > summary {
		display: grid;
		grid-template-columns: auto 6rem minmax(0, 1fr) 0.6rem;
		gap: 0.9rem;
		align-items: center;
		padding: 0.6rem 0.9rem;
		border-radius: 0.6rem;
		cursor: pointer;
		list-style: none;
	}
	/* Safari draws its own triangle on a summary unless this hides it. */
	.satre-topic > summary::-webkit-details-marker {
		display: none;
	}
	.satre-topic > summary:hover {
		background: var(--sl-color-gray-7);
	}
	.satre-topic > summary:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: -2px;
	}
	/* A chevron that points down, and up when the list is open. */
	.satre-topic > summary::after {
		content: '';
		width: 0.4rem;
		height: 0.4rem;
		border-right: 1.5px solid var(--sl-color-gray-3);
		border-bottom: 1.5px solid var(--sl-color-gray-3);
		transform: rotate(45deg) translate(-1px, -1px);
		transition: transform 0.15s ease;
	}
	.satre-topic[open] > summary::after {
		transform: rotate(-135deg) translate(-1px, -1px);
	}
	.satre-topic__title {
		font-weight: 600;
	}
	/* A thin bar that splits the topic's entries by status. */
	.satre-topic__track {
		display: flex;
		gap: 2px;
		height: 0.5rem;
		overflow: hidden;
		border-radius: 4px;
	}
	.satre-topic__counts {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.satre-topic .satre-entries {
		padding: 0 0.6rem;
	}
	.satre-topic__reviewed {
		margin: 0;
		padding: 0.5rem 0.9rem 0.7rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	/* On a phone the bar and the counts go under the title. */
	@media (max-width: 40rem) {
		.satre-topic > summary {
			grid-template-columns: minmax(0, 1fr) 0.6rem;
			gap: 0.3rem 0.9rem;
		}
		.satre-topic__track {
			grid-column: 1;
			width: 6rem;
		}
		.satre-topic__counts {
			grid-column: 1;
		}
		.satre-topic > summary::after {
			grid-area: 1 / 2;
		}
	}

	@media print {
		.satre-topic {
			break-inside: avoid;
		}
		.satre-topic > summary::after {
			display: none;
		}
	}
	/* The script opens each list before printing. This rule also shows the
	   content of a list that is still closed when the page prints, in the
	   browsers that support ::details-content. It is a separate rule because
	   a browser that does not know the selector would drop the whole rule. */
	@media print {
		.satre-topic::details-content {
			content-visibility: visible;
		}
	}
</style>
